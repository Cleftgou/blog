---
import fs from "node:fs";
import MainGridLayout from "../layouts/MainGridLayout.astro";

interface AlbumItem { name: string; birth: string; width: number; height: number; thumb: string; }
const indexData: AlbumItem[] = JSON.parse(
    fs.readFileSync("public/images/album/index.json", "utf-8")
);

const groups = new Map<string, { year: number; month: number; items: AlbumItem[] }>();
for (const item of indexData) {
    const d = new Date(item.birth);
    const year = d.getFullYear();
    const month = d.getMonth() + 1;
    const key = `${year}-${month.toString().padStart(2, "0")}`;
    if (!groups.has(key)) groups.set(key, { year, month, items: [] });
    groups.get(key)!.items.push(item);
}
const groupEntries = Array.from(groups.values()).map(g => ({
    ...g,
    items: g.items.map(item => ({
        ...item,
        thumbSrc: `/images/album/${item.thumb.split("/").map(encodeURIComponent).join("/")}`,
        fullSrc: import.meta.env.PROD
	            ? `/images/album/${item.thumb.split("/").map(encodeURIComponent).join("/")}`
	            : `/images/album/${encodeURIComponent(item.name)}`,
    })),
}));
---
<MainGridLayout title="相册" description="相册">
    <div class="w-full rounded-[var(--radius-large)] overflow-hidden">
        <div class="card-base px-8 py-6">
            <h2 class="text-3xl mb-6">相册</h2>
            <div class="space-y-10">
                {groupEntries.map(group => (
                    <div>
                        <div class="flex flex-row w-full items-center h-[3.75rem]">
                            <div class="w-[15%] md:w-[10%] transition text-2xl font-bold text-right text-75">
                                {group.year}
                            </div>
                            <div class="w-[15%] md:w-[10%]">
                                <div class="h-3 w-3 bg-none rounded-full outline outline-[var(--primary)] mx-auto -outline-offset-[2px] z-50 outline-3"></div>
                            </div>
                            <div class="w-[70%] md:w-[80%] transition text-left text-50">
                                {group.month} 月 · {group.items.length} 张
                            </div>
                        </div>
                        <div class="album-grid grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 px-2">
                            {group.items.map(item => (
                                <img
                                    src={item.thumbSrc}
                                    data-pswp-src={item.fullSrc}
                                    data-pswp-width={item.width}
                                    data-pswp-height={item.height}
                                    loading="lazy"
                                    alt=""
                                    class="w-full aspect-square object-cover rounded-[var(--radius-large)] transition hover:opacity-90 cursor-zoom-in"
                                />
                            ))}
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>
</MainGridLayout>